<?xml version="1.0" encoding="UTF-8"?>
<!-- 품목 기준정보 송신 매핑/적재 -->
<FLOW VERSION="3.0" CLEANUP="true">
  <SEQUENCE NAME="main" EXIT-ON="DONE">
    <!-- 정상 처리 구간 -->
    <SEQUENCE NAME="try" EXIT-ON="FAILURE">
      <!-- 트랜잭션 시작 -->
      <INVOKE SERVICE="pub.art.transaction:startTransaction" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 원천 → 타깃 직접 매핑 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ITM_NAME_LO;1;0" TO="/IF_ITEM_RCV;2;0/ITEM_NM;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ITM_GRP;1;0" TO="/IF_ITEM_RCV;2;0/ITEM_GRP_CD;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/UOM;1;0" TO="/IF_ITEM_RCV;2;0/UNIT_CD;1;0"/>
      </MAP>
      <!-- 원천 → 타깃 직접 매핑 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/NET_WGT;1;0" TO="/IF_ITEM_RCV;2;0/UNIT_WGT;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/PACK_QTY;1;0" TO="/IF_ITEM_RCV;2;0/BOX_QTY;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ACT_FLG;1;0" TO="/IF_ITEM_RCV;2;0/USE_YN;1;0"/>
      </MAP>
      <!-- 원천 → 스테이징 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/CHG_DT;1;0" TO="/IF_ITEM_RCV_STG;2;0/IF_YMD;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ITM_CODE;1;0" TO="/IF_ITEM_RCV_STG;2;0/ITEM_CD;1;0"/>
      </MAP>
      <!-- 스테이징 → 타깃 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/IF_ITEM_RCV_STG;2;0/IF_YMD;1;0" TO="/IF_ITEM_RCV;2;0/IF_YMD;1;0"/>
        <MAPCOPY FROM="/IF_ITEM_RCV_STG;2;0/ITEM_CD;1;0" TO="/IF_ITEM_RCV;2;0/ITEM_CD;1;0"/>
      </MAP>
      <!-- 검증/로그용 필드 추출 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ITM_CODE;1;0" TO="/dataCount;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ITM_NAME_LO;1;0" TO="/prevCount;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ITM_GRP;1;0" TO="/baseYmd;1;0"/>
      </MAP>
      <!-- 검증/로그용 필드 추출 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/UOM;1;0" TO="/lastKey;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/NET_WGT;1;0" TO="/errCount;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/PACK_QTY;1;0" TO="/jobId;1;0"/>
      </MAP>
      <!-- 검증/로그용 필드 추출 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ACT_FLG;1;0" TO="/procFlag;1;0"/>
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/CHG_DT;1;0" TO="/chkSum;1;0"/>
      </MAP>
      <!-- 상수 설정 -->
      <MAP MODE="STANDALONE">
        <MAPSET FIELD="/IF_ITEM_RCV;2;0/IF_SEQ;1;0">
          <VALUE NAME="IF_SEQ">SEQ</VALUE>
        </MAPSET>
        <MAPSET FIELD="/IF_ITEM_RCV;2;0/SND_SYS_CD;1;0">
          <VALUE NAME="SND_SYS_CD">ERP</VALUE>
        </MAPSET>
        <MAPSET FIELD="/IF_ITEM_RCV;2;0/IF_STAT_CD;1;0">
          <VALUE NAME="IF_STAT_CD">10</VALUE>
        </MAPSET>
        <MAPSET FIELD="/IF_ITEM_RCV;2;0/RCV_DTM;1;0">
          <VALUE NAME="RCV_DTM">SYSDATE</VALUE>
        </MAPSET>
      </MAP>
      <!-- 인라인 변환기 적용 -->
      <MAP MODE="STANDALONE">
        <!-- pub.string:replace 변환 적용 -->
        <MAPINVOKE SERVICE="pub.string:replace" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
          <MAP MODE="INPUT">
            <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ITM_NAME_LO;1;0" TO="/inString;1;0"/>
            <MAPSET FIELD="/searchString;1;0">
              <VALUE NAME="searchString"> </VALUE>
            </MAPSET>
          </MAP>
          <MAP MODE="OUTPUT">
            <MAPCOPY FROM="/value;1;0" TO="/IF_ITEM_RCV;2;0/ITEM_NM;1;0"/>
          </MAP>
        </MAPINVOKE>
        <!-- pub.math:addInts 변환 적용 -->
        <MAPINVOKE SERVICE="pub.math:addInts" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
          <MAP MODE="INPUT">
            <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ACT_FLG;1;0" TO="/num1;1;0"/>
            <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/ACT_FLG;1;0" TO="/num2;1;0"/>
          </MAP>
          <MAP MODE="OUTPUT">
            <MAPCOPY FROM="/value;1;0" TO="/IF_ITEM_RCV;2;0/USE_YN;1;0"/>
          </MAP>
        </MAPINVOKE>
      </MAP>
      <!-- SYNIF.IF_ITEM_RCV 적재 -->
      <INVOKE SERVICE="SYN.WMS.S0001.adpt:IF_ITEM_RCV_I_01" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 트랜잭션 종료 -->
      <INVOKE SERVICE="pub.art.transaction:commitTransaction" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 보조 계산 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/dataCount;1;0" TO="/prevCount;1;0"/>
        <MAPCOPY FROM="/prevCount;1;0" TO="/baseYmd;1;0"/>
        <MAPCOPY FROM="/baseYmd;1;0" TO="/lastKey;1;0"/>
      </MAP>
      <!-- 보조 계산 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/lastKey;1;0" TO="/errCount;1;0"/>
        <MAPCOPY FROM="/errCount;1;0" TO="/jobId;1;0"/>
        <MAPCOPY FROM="/jobId;1;0" TO="/procFlag;1;0"/>
      </MAP>
      <!-- 보조 계산 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/procFlag;1;0" TO="/chkSum;1;0"/>
        <MAPCOPY FROM="/IF_ITEM_RCV;2;0/IF_SEQ;1;0" TO="/dataCount;1;0"/>
        <MAPCOPY FROM="/IF_ITEM_RCV;2;0/IF_YMD;1;0" TO="/prevCount;1;0"/>
      </MAP>
      <!-- 보조 계산 -->
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/IF_OUT_ITEM_MASTER;4;0;SYN_WMS_S_0001.docs:IF_OUT_ITEM_MASTER/results;2;0/detail;2;0/ITM_NAME_EN;1;0" TO="/dataCount;1;0"/>
      </MAP>
      <!-- 파이프라인 정리 -->
      <MAP MODE="STANDALONE">
        <MAPDELETE FIELD="/IF_ITEM_RCV_STG;2;0/IF_YMD;1;0"/>
        <MAPDELETE FIELD="/IF_ITEM_RCV_STG;2;0/ITEM_CD;1;0"/>
        <MAPDELETE FIELD="/dataCount;1;0"/>
      </MAP>
      <!-- 파이프라인 정리 -->
      <MAP MODE="STANDALONE">
        <MAPDELETE FIELD="/prevCount;1;0"/>
        <MAPDELETE FIELD="/baseYmd;1;0"/>
        <MAPDELETE FIELD="/lastKey;1;0"/>
      </MAP>
      <!-- 파이프라인 정리 -->
      <MAP MODE="STANDALONE">
        <MAPDELETE FIELD="/errCount;1;0"/>
        <MAPDELETE FIELD="/jobId;1;0"/>
        <MAPDELETE FIELD="/procFlag;1;0"/>
      </MAP>
      <!-- 파이프라인 정리 -->
      <MAP MODE="STANDALONE">
        <MAPDELETE FIELD="/chkSum;1;0"/>
        <MAPDELETE FIELD="/rowIdx;1;0"/>
        <MAPDELETE FIELD="/statCd;1;0"/>
      </MAP>
      <!-- 처리 단계 블록 -->
      <SEQUENCE NAME="step5" EXIT-ON="FAILURE">
        <!-- 후처리 단계 -->
        <INVOKE SERVICE="SYNCOM.util:writeIfLog" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        </INVOKE>
      </SEQUENCE>
      <!-- 공통 유틸리티 호출 -->
      <INVOKE SERVICE="SYNCOM.util:nextSequence" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 공통 유틸리티 호출 -->
      <INVOKE SERVICE="SYNCOM.util:writeIfLog" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
    </SEQUENCE>
    <!-- 예외 처리 구간 -->
    <SEQUENCE NAME="catch" EXIT-ON="DONE">
      <!-- 오류 정보 수집 -->
      <INVOKE SERVICE="pub.flow:getLastError" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 오류 카운터 증가 -->
      <INVOKE SERVICE="SYNCOM.util:incErrCount" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 오류 건수에 따른 로그 분기 -->
      <BRANCH SWITCH="/errCount;1;0">
        <!-- case $default -->
        <SEQUENCE NAME="warn" EXIT-ON="FAILURE">
          <!-- 경고 로그 -->
          <INVOKE SERVICE="SYNCOM.util:writeIfLog" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
          </INVOKE>
        </SEQUENCE>
        <!-- case 0 -->
        <SEQUENCE NAME="none" EXIT-ON="FAILURE">
          <!-- 정상 종료 로그 -->
          <INVOKE SERVICE="pub.flow:debugLog" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
          </INVOKE>
        </SEQUENCE>
      </BRANCH>
    </SEQUENCE>
  </SEQUENCE>
</FLOW>
