<?xml version="1.0" encoding="UTF-8"?>
<!-- 품목 기준정보 송신 제어 -->
<FLOW VERSION="3.0" CLEANUP="true">
  <SEQUENCE NAME="main" EXIT-ON="DONE">
    <!-- 정상 처리 구간 -->
    <SEQUENCE NAME="try" EXIT-ON="FAILURE">
      <!-- 원천 조회 호출 -->
      <INVOKE SERVICE="SYN.WMS.S0001.srvc:SYN_WMS_S_0001_source" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <MAP MODE="STANDALONE">
        <MAPCOPY FROM="/dataCount;1;0" TO="/prevCount;1;0"/>
      </MAP>
      <!-- 매핑/적재 호출 -->
      <INVOKE SERVICE="SYN.WMS.S0001.srvc:SYN_WMS_S_0001_target" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 처리 단계 블록 -->
      <SEQUENCE NAME="step3" EXIT-ON="FAILURE">
        <!-- 후처리 단계 -->
        <INVOKE SERVICE="SYNCOM.util:nextSequence" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        </INVOKE>
      </SEQUENCE>
      <!-- 처리 단계 블록 -->
      <SEQUENCE NAME="step4" EXIT-ON="FAILURE">
        <!-- 후처리 단계 -->
        <INVOKE SERVICE="SYNCOM.util:checkMandatory" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        </INVOKE>
      </SEQUENCE>
      <!-- 처리 단계 블록 -->
      <SEQUENCE NAME="step5" EXIT-ON="FAILURE">
        <!-- 후처리 단계 -->
        <INVOKE SERVICE="SYNCOM.util:writeIfLog" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        </INVOKE>
      </SEQUENCE>
      <!-- 공통 유틸리티 호출 -->
      <INVOKE SERVICE="SYNCOM.util:writeIfLog" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 공통 유틸리티 호출 -->
      <INVOKE SERVICE="pub.date:getCurrentDateString" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 공통 유틸리티 호출 -->
      <INVOKE SERVICE="pub.flow:getLastError" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
    </SEQUENCE>
    <!-- 예외 처리 구간 -->
    <SEQUENCE NAME="catch" EXIT-ON="DONE">
      <!-- 오류 정보 수집 -->
      <INVOKE SERVICE="pub.flow:getLastError" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
      <!-- 오류 카운터 증가 -->
      <INVOKE SERVICE="SYNCOM.util:incErrCount" TIMEOUT="" VALIDATE-IN="$none" VALIDATE-OUT="$none">
      </INVOKE>
    </SEQUENCE>
  </SEQUENCE>
</FLOW>
